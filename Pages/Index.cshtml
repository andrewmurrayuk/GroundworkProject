@page
@model Groundwork.Pages.IndexModel
@{
    Layout = "Shared/_Layout";
}

<div class="shell">
    <header class="masthead">
        <div class="wordmark">
            <span class="wordmark-main">Groundwork</span>
            <span class="wordmark-sub">Desk research, done while you do something else</span>
        </div>
    </header>

    <main class="columns">
        <section class="panel panel-input">
            <h1 class="panel-title">New project</h1>

            <label class="field-label" for="project-name">Project name</label>
            <input id="project-name" type="text" class="text-input" placeholder="e.g. NHS discharge delays" />

            <label class="field-label" for="project-description">Description <span class="optional">optional</span></label>
            <textarea id="project-description" rows="3" placeholder="What this research is for"></textarea>

            <button id="create-project" class="run-button" type="button">Create project</button>
            <p class="error-line" id="create-error" hidden></p>
        </section>

        <section class="panel panel-ledger">
            <div class="ledger-head">
                <h2 class="panel-title">Projects</h2>
                <p class="status-line" id="projects-status">Loading…</p>
            </div>
            <div class="ledger-empty" id="projects-empty" hidden>
                <p>No projects yet. Create one to start a durable body of research — briefs, seed lists, and every run's briefing stay with the project.</p>
            </div>
            <ol class="project-list" id="project-list"></ol>
        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/projects.js" asp-append-version="true"></script>
}
